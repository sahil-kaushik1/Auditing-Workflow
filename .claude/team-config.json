{
  "_comment": "Smart Contract Auditing Harness — team configuration. 11 agents, 3-stage pipeline, 7 quality gates.",

  "project": {
    "name": "{{PROJECT_NAME}}",
    "short_name": "{{PROJECT_SHORT}}",
    "repo": "{{PROJECT_REPO}}",
    "domain": "smart-contract-auditing",
    "github_org": "{{GITHUB_ORG}}",
    "company": "{{COMPANY_NAME}}"
  },

  "workflow": {
    "ticket_prefix": "{{TICKET_PREFIX}}",
    "main_branch": "{{MAIN_BRANCH}}",
    "branch_format": "{{TICKET_PREFIX}}-{number}-{description}",
    "commit_format": "type(scope): description [{{TICKET_PREFIX}}-XXX]",
    "merge_strategy": "rebase-and-merge"
  },

  "agents": {
    "_comment": "11 audit agents mapped to the 3-stage pipeline.",

    "orchestrator": {
      "name": "Orchestrator",
      "config_file": ".claude/agents/orchestrator.md",
      "category": "planning",
      "description": "Resource scheduler, gap analysis, cycle management, 70/30 budget enforcement",
      "collapsible": true,
      "primary_tools": ["read", "write", "bash"],
      "exit_state": "Cycle {N} complete"
    },
    "decomposer": {
      "name": "Decomposer",
      "config_file": ".claude/agents/decomposer.md",
      "category": "planning",
      "description": "10-dimensional project decomposition (modules, entrypoints, data-flow, assets, state-machines, permissions, async, config, invariants, business-flows)",
      "collapsible": false,
      "primary_tools": ["read", "grep", "bash"],
      "exit_state": "Decomposition complete"
    },
    "threat-modeler": {
      "name": "Threat Modeler",
      "config_file": ".claude/agents/threat-modeler.md",
      "category": "planning",
      "description": "Task compiler — converts decomposition into 9-field proof obligations",
      "collapsible": false,
      "primary_tools": ["read", "write", "grep"],
      "exit_state": "Tasks compiled"
    },
    "deep-reasoner": {
      "name": "Deep Reasoner",
      "config_file": ".claude/agents/deep-reasoner.md",
      "category": "execution",
      "description": "Constrained reasoning inside task boundaries with drift self-check",
      "collapsible": false,
      "primary_tools": ["read", "bash", "grep"],
      "exit_state": "Reasoning complete for TASK-{N}"
    },
    "hypothesis-generator": {
      "name": "Hypothesis Generator",
      "config_file": ".claude/agents/hypothesis-generator.md",
      "category": "execution",
      "description": "Creative divergent vulnerability hypothesis clouds (optional, not in audit-grade primary pipeline)",
      "collapsible": true,
      "primary_tools": ["read", "grep"],
      "exit_state": "Hypotheses generated"
    },
    "sast-integrator": {
      "name": "SAST Integrator",
      "config_file": ".claude/agents/sast-integrator.md",
      "category": "execution",
      "description": "Slither, call graphs, storage layouts, data-flow — structural facts only",
      "collapsible": true,
      "primary_tools": ["bash", "read", "write", "grep"],
      "exit_state": "SAST analysis complete"
    },
    "verifier": {
      "name": "Verifier",
      "config_file": ".claude/agents/verifier.md",
      "category": "quality",
      "description": "Independent verification via Foundry PoCs, invariant tests, fuzzing. NEVER shares context with Reasoner.",
      "collapsible": false,
      "primary_tools": ["read", "bash", "write", "grep"],
      "exit_state": "Verification complete",
      "gate_owner": false,
      "independence_requirement": "Must not receive Reasoner's chain-of-thought"
    },
    "judge": {
      "name": "Judge",
      "config_file": ".claude/agents/judge.md",
      "category": "quality",
      "description": "Gate owner for decomposition, task quality, drift detection, evidence evaluation. Finding classifier. Non-collapsible.",
      "collapsible": false,
      "primary_tools": ["read", "grep"],
      "exit_state": "Gate PASSED/FAILED",
      "gate_owner": true,
      "gates_owned": ["decomposition_gate", "task_quality_gate", "drift_detection_gate", "evidence_gate"]
    },
    "context-builder": {
      "name": "Context Builder",
      "config_file": ".claude/agents/context-builder.md",
      "category": "quality",
      "description": "Per-task context provisioning. Enforces trigger, responsibility, and context isolation.",
      "collapsible": true,
      "primary_tools": ["read", "grep", "bash"],
      "exit_state": "Context package built"
    },
    "report-compiler": {
      "name": "Report Compiler",
      "config_file": ".claude/agents/report-compiler.md",
      "category": "quality",
      "description": "Structured findings, gap records, coverage maps, executive summary",
      "collapsible": true,
      "primary_tools": ["read", "write", "grep"],
      "exit_state": "Report compiled"
    },
    "evolution-manager": {
      "name": "Evolution Manager",
      "config_file": ".claude/agents/evolution-manager.md",
      "category": "evolution",
      "description": "Long loop: review attribution (8 failure types), A/B testing, rollback, selective inheritance",
      "collapsible": true,
      "primary_tools": ["read", "write", "grep", "bash"],
      "exit_state": "Evolution analysis complete"
    }
  },

  "quality_gates": {
    "_comment": "7 blocking quality gates in the audit pipeline.",
    "decomposition_gate": {
      "name": "Decomposition Gate",
      "owner": "judge",
      "blocking": true,
      "stage": "post-decomposition",
      "checks": "All 10 dimensions, invariants explicit, flows mapped end-to-end"
    },
    "task_quality_gate": {
      "name": "Task Quality Gate",
      "owner": "judge",
      "blocking": true,
      "stage": "post-task-definition",
      "checks": "All 9 task fields, falsifiable predicates, no overlaps, business-flow tasks present"
    },
    "drift_detection_gate": {
      "name": "Drift Detection Gate",
      "owner": "judge",
      "blocking": true,
      "stage": "post-reasoning",
      "checks": "Reasoner output matches task drift anchors, target function analyzed, defined path followed"
    },
    "verification_gate": {
      "name": "Verification Gate",
      "owner": "judge",
      "blocking": true,
      "stage": "post-verification",
      "checks": "Evidence sufficient to classify (CONFIRMED/REFUTED/INCONCLUSIVE)"
    },
    "evidence_gate": {
      "name": "Evidence Gate",
      "owner": "judge",
      "blocking": true,
      "stage": "pre-report",
      "checks": "Concrete witness present OR safety actively proven with evidence"
    },
    "evolution_gate": {
      "name": "Evolution Gate",
      "owner": "evolution-manager",
      "blocking": true,
      "stage": "between-audits",
      "checks": "Change measured, no regression, rollback possible, works on 3+ projects"
    },
    "hitl_gate": {
      "name": "HITL Final Review",
      "owner": "human-auditor",
      "blocking": true,
      "stage": "final",
      "checks": "Human auditor reviews all findings, gap records, and coverage map"
    }
  },

  "pipeline": {
    "_comment": "3-stage audit pipeline with resource allocation.",
    "stages": {
      "stage_1_decomposition": {
        "budget_share": "60-70%",
        "agents": ["sast-integrator", "decomposer", "context-builder"],
        "output": "specs/decomposition/, specs/sast/",
        "gate": "decomposition_gate"
      },
      "stage_2_task_definition": {
        "budget_share": "included in stage 1",
        "agents": ["threat-modeler"],
        "output": "specs/tasks/",
        "gate": "task_quality_gate"
      },
      "stage_3_reasoning_verification": {
        "budget_share": "30-40%",
        "agents": ["context-builder", "deep-reasoner", "verifier"],
        "output": "specs/reasoning/, specs/verification/",
        "gates": ["drift_detection_gate", "verification_gate", "evidence_gate"]
      }
    },
    "cycles": {
      "gap_analysis_after_each_cycle": true,
      "supplemental_tasks_from_gaps": true,
      "do_not_repeat_full_audit": true
    }
  },

  "scanner_modes": {
    "audit_grade": {
      "budget_split": "70/30",
      "verification": "full_mandatory",
      "gap_cycles": true,
      "hypothesis_generator": false
    },
    "discovery": {
      "budget_split": "50/50",
      "verification": "lighter",
      "gap_cycles": true,
      "hypothesis_generator": true
    },
    "contest_rush": {
      "budget_split": "40/60",
      "verification": "parallel_hypotheses",
      "gap_cycles": false,
      "hypothesis_generator": true
    },
    "fast_triage": {
      "budget_split": "30/70",
      "verification": "on_demand",
      "gap_cycles": false,
      "hypothesis_generator": false
    }
  },

  "resource_scheduling": {
    "allocate": {
      "description": "Split audit goal into tasks via Threat Modeler"
    },
    "extract": {
      "description": "Require structured output per task",
      "required_outputs": ["evidence", "witnesses", "counterexamples", "unresolved_questions", "assumptions"]
    },
    "reallocate": {
      "description": "Gap analysis directs next cycle budget",
      "criteria": [
        "never_covered_paths",
        "shallow_proofs",
        "unchallenged_safety_conclusions",
        "missing_cross_module_checks",
        "boundary_values_not_examined",
        "missing_state_transitions",
        "missing_differential_comparisons"
      ]
    }
  },

  "finding_classification": {
    "hypothesis": "Reasoner proposed, no verification",
    "candidate": "Verified but lacks full impact proof",
    "verified": "PoC passes, attack path reproducible",
    "confirmed": "Verified + impact assessed + severity assigned"
  },

  "review_attribution_categories": [
    "task_design_failure",
    "missing_failure_predicate",
    "missing_witness_requirement",
    "context_failure",
    "reasoning_failure",
    "verification_failure",
    "artifact_failure",
    "reporting_failure"
  ],

  "paths": {
    "agent_configs": ".claude/agents/",
    "skills": ".agents/skills/",
    "decomposition": "specs/decomposition/",
    "sast": "specs/sast/",
    "tasks": "specs/tasks/",
    "context": "specs/context/",
    "reasoning": "specs/reasoning/",
    "verification": "specs/verification/",
    "hypotheses": "specs/hypotheses/",
    "gates": "specs/gates/",
    "cycles": "specs/cycles/",
    "evolution": "specs/evolution/",
    "findings": "findings/",
    "patterns": "patterns_library/",
    "templates": "specs_templates/"
  }
}